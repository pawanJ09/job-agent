# Copy this file to .env and fill in every value marked REQUIRED.
# In Terminal:  cp .env.example .env
# Keep .env private. It holds your passwords and keys.

# REQUIRED. Make up a database password. Use letters and numbers only.
POSTGRES_PASSWORD=change_me

# REQUIRED. The Gmail account that receives your LinkedIn job alerts.
GMAIL_USER=you@gmail.com
# REQUIRED. A 16-character Google app password (README, step 2), with no spaces.
GMAIL_APP_PASSWORD=your_16_char_app_password
# The Gmail label your alerts are filed under. Must match the label name exactly.
GMAIL_LABEL=LinkedIn Alerts

# REQUIRED. An OpenAI API key from an account that has credit (README, step 3).
OPENAI_API_KEY=your_openai_api_key_here

# REQUIRED. The address that receives the daily digest.
DIGEST_RECIPIENT=you@gmail.com
# REQUIRED. Gmail's mail server. Leave these two as they are.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Path inside the container to your resume (PDF or DOCX). The default matches a file
# named resume.pdf in the data folder. For a Word file, use /app/data/resume.docx.
RESUME_PATH=/app/data/resume.pdf

# When the daily run happens. SET THE TIMEZONE TO YOURS, using a name like
# America/New_York, America/Los_Angeles, Europe/London, Asia/Kolkata.
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=UTC

# Jobs scoring below this (0 to 1) are skipped and never get a draft. If you get no
# drafts at all, lower it. The README explains how to see your scores.
MATCH_THRESHOLD=0.60

# How many days of alert emails to scan on each run.
ALERT_LOOKBACK_DAYS=2

# Pause, in seconds, between fetching each job posting. Keep these generous.
FETCH_DELAY_MIN_SECONDS=10
FETCH_DELAY_MAX_SECONDS=30
