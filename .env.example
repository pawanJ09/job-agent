# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# --- Postgres (step 2) ---
POSTGRES_PASSWORD=change_me

# --- Gmail IMAP (step 3) ---
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_LABEL=LinkedIn Alerts
# How many days back to re-scan on each run (safe to re-scan -- duplicates are
# skipped via job_id). 2 gives a buffer in case a run gets missed one day.
ALERT_LOOKBACK_DAYS=2

# --- Job detail fetcher (step 4) ---
# OPTIONAL. The fetcher requests postings anonymously first. If that fails and this
# file exists, it retries using the saved login session. Create the file by running
# save_session.py locally on your host machine (not in Docker). Safe to leave as-is
# if you never create the file.
LINKEDIN_SESSION_PATH=/app/data/auth_state.json
# Random delay range (seconds) between fetching each job posting.
FETCH_DELAY_MIN_SECONDS=10
FETCH_DELAY_MAX_SECONDS=30

# --- Resume (step 2) ---
# Path inside the container to your resume file (PDF or DOCX)
RESUME_PATH=/app/data/resume.pdf

# --- OpenAI (steps 5 and 6 share this key) ---
# Step 5 uses it for embeddings (text-embedding-3-small).
# Step 6 uses it for chat completions (gpt-4o-mini) to draft messages.
OPENAI_API_KEY=your_openai_api_key_here

# --- Job matcher (step 5) ---
# Cosine similarity cutoff (0-1) above which a posting counts as a match.
# This is a starting guess -- run the matcher once, look at the printed
# scores for postings you know are/aren't a fit, and adjust.
MATCH_THRESHOLD=0.75

# --- Mailer (step 7) ---
# Reuses GMAIL_USER / GMAIL_APP_PASSWORD from above for SMTP login -- a
# Gmail app password isn't service-specific, so the same one works for
# both IMAP (step 3) and SMTP here. No separate credential needed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
DIGEST_RECIPIENT=you@gmail.com

# --- Scheduler / orchestration (step 8) ---
# What time (24h, local container time) the full pipeline runs each day.
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
# Timezone the hour/minute above are interpreted in. Use an IANA name (not
# "CDT"), so daylight saving changes are handled automatically. Without this
# the container would use UTC. Examples: America/Chicago, America/New_York,
# America/Los_Angeles, Europe/London.
SCHEDULE_TIMEZONE=America/Chicago
# If the machine was asleep at the scheduled time, the pipeline still runs
# when it wakes, as long as that's within this many hours of the scheduled time.
CATCHUP_GRACE_HOURS=12
# "schedule" (default) runs forever on the daily schedule above -- this is
# what the container normally runs. Set to "once" for a single immediate
# end-to-end test run that exits when done:
#   docker compose run --rm -e RUN_MODE=once app python main.py
RUN_MODE=schedule
