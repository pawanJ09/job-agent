# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# --- Postgres (step 2) ---
POSTGRES_PASSWORD=change_me

# --- Gmail IMAP (step 3) ---
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_LABEL=LinkedIn Alerts
# How many days back to re-scan on each run (safe to re-scan -- duplicates are
# skipped via job_id). 2 gives a buffer in case a run gets missed one day.
ALERT_LOOKBACK_DAYS=2

# --- Job detail fetcher (step 4) ---
# Path inside the container to a saved Playwright storage_state.json
# Created by running save_session.py locally on your host machine (not in
# Docker) -- see save_session.py for instructions.
LINKEDIN_SESSION_PATH=/app/data/auth_state.json
# Random delay range (seconds) between fetching each job posting.
FETCH_DELAY_MIN_SECONDS=10
FETCH_DELAY_MAX_SECONDS=30

# --- Resume (step 2) ---
# Path inside the container to your resume file (PDF or DOCX)
RESUME_PATH=/app/data/resume.pdf

# --- Job matcher (step 5) ---
# Used to generate embeddings (OpenAI text-embedding-3-small) for comparing
# job descriptions against your resume.
OPENAI_API_KEY=your_openai_api_key_here
# Cosine similarity cutoff (0-1) above which a posting counts as a match.
# This is a starting guess -- run the matcher once, look at the printed
# scores for postings you know are/aren't a fit, and adjust.
MATCH_THRESHOLD=0.75

# --- Message drafter (step 6) ---
# Provider/key decided when we build step 6.
LLM_API_KEY=your_api_key_here

# --- Mailer (step 7) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_char_app_password
DIGEST_RECIPIENT=you@gmail.com
